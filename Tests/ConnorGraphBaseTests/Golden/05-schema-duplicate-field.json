    },
    "appContext": { "appID": "acct", "visibility": "private", "packageVersion": 1 }
  },
  "then": {
    "envelope": { "ok": false, "data": null, "error": { "code": "VALIDATION_FAILED", "message": "字段名重复", "hint": "同一表内字段名须唯一", "retryable": false }, "site": "local" },
